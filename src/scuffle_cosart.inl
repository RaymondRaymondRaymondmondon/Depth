// Scuffle stage 9: how the skins and hats look (included by scuffle_game.cpp). A skin changes the stick's line: its
// colour, its weight, what it's made of (bones, wire, chalk, gold leaf, wet noodle); a hat is drawn on the head along
// its tilt, or tumbling on its own when a headshot has sent it flying. The seat's colour stays on the head ring, so
// everyone can still tell who is who.

namespace cosart {
struct Look { Color line, ink; float alpha = 1, width = 1; };
std::string SkinId(const sf::Stick& k) { return k.skin >= 0 && k.skin < (int)sf::Skins().size() ? sf::Skins()[k.skin].id : std::string(); }
std::string HatId(int h) { return h >= 0 && h < (int)sf::Hats().size() ? sf::Hats()[h].id : std::string(); }
uint32_t Hash(int a, int b) { uint32_t h = (uint32_t)a * 2654435761u ^ (uint32_t)b * 40503u; h ^= h >> 13; h *= 0x5bd1e995u; return h ^ (h >> 15); }

// the limbs in a skin: true if drawn (else the plain stick's line is used). P(j) is a joint on the screen.
template <class PF> bool Limbs(const sf::Stick& k, Color seat, float th, PF P, const int (*SEG)[2], int nSeg, float* alphaOut) {
    std::string s = SkinId(k); if (s.empty()) return false;
    float t = S.t; float a = s == "ghost" ? 0.4f : 1.0f; *alphaOut = a;
    auto A = [&](Color c) { return ColorAlpha(c, a * c.a / 255.0f); };
    auto line = [&](Vector2 p, Vector2 q, float w, Color c, Color ink) { DrawLineEx(p, q, w + 2.5f, A(ink)); DrawCircleV(p, (w + 2.5f) / 2, A(ink)); DrawCircleV(q, (w + 2.5f) / 2, A(ink)); DrawLineEx(p, q, w, A(c)); DrawCircleV(p, w / 2, A(c)); DrawCircleV(q, w / 2, A(c)); };
    auto each = [&](auto fn) { for (int i = 0; i < nSeg; i++) fn(P(SEG[i][0]), P(SEG[i][1]), i); };
    Color dead{120, 116, 110, 255};
    auto tint = [&](Color c) { return k.alive ? c : ColorLerp(c, dead, 0.6f); };
    if (s == "ink") { each([&](Vector2 p, Vector2 q, int i) { Vector2 m = Vector2Lerp(p, q, 0.5f); m.x += sinf(t * 7 + i) * 2; m.y += cosf(t * 6 + i * 2) * 2; line(p, m, th * 1.6f, tint(INK), INK); line(m, q, th * 1.6f, tint(INK), INK); }); return true; }
    if (s == "chalk") { each([&](Vector2 p, Vector2 q, int i) { line(p, q, th, tint(Color{240, 238, 228, 255}), Color{50, 56, 60, 255}); for (int d = 0; d < 4; d++) { Vector2 m = Vector2Lerp(p, q, (d + 0.5f) / 4); DrawCircleV({m.x + (Hash(i, d) % 5) - 2.0f, m.y + (Hash(d, i) % 5) - 2.0f}, 1, A(Color{200, 200, 196, 255})); } }); return true; }
    if (s == "brass") { each([&](Vector2 p, Vector2 q, int) { line(p, q, th * 1.1f, tint(Color{200, 160, 70, 255}), INK); for (float u : {0.2f, 0.8f}) DrawCircleV(Vector2Lerp(p, q, u), std::max(1.5f, th * 0.25f), A(Color{120, 90, 30, 255})); }); return true; }
    if (s == "skeleton") { each([&](Vector2 p, Vector2 q, int) { line(p, q, th * 0.55f, tint(Color{238, 234, 220, 255}), INK); for (Vector2 e : {Vector2Lerp(p, q, 0.08f), Vector2Lerp(p, q, 0.92f)}) { DrawCircleV(e, th * 0.55f + 1.5f, A(INK)); DrawCircleV(e, th * 0.55f, A(tint(Color{238, 234, 220, 255}))); } }); return true; }
    if (s == "ghost") { each([&](Vector2 p, Vector2 q, int) { line(p, q, th, tint(Color{220, 230, 240, 255}), Color{120, 140, 160, 255}); }); return true; }
    if (s == "wire") { each([&](Vector2 p, Vector2 q, int i) { Vector2 m = Vector2Lerp(p, q, 0.5f); m.x += (i % 2 ? 3.0f : -3.0f); DrawLineEx(p, m, std::max(1.5f, th * 0.4f), A(tint(Color{150, 156, 160, 255}))); DrawLineEx(m, q, std::max(1.5f, th * 0.4f), A(tint(Color{150, 156, 160, 255}))); }); return true; }
    if (s == "neon") { each([&](Vector2 p, Vector2 q, int) { DrawLineEx(p, q, th * 3, A(ColorAlpha(seat, 0.25f))); line(p, q, th, tint(ColorLerp(seat, WHITE, 0.5f)), seat); }); return true; }
    if (s == "noodle") { each([&](Vector2 p, Vector2 q, int i) { Vector2 d = Vector2Subtract(q, p), n = Vector2Normalize({-d.y, d.x}); Vector2 last = p; for (int u = 1; u <= 6; u++) { float f = u / 6.0f; Vector2 w = Vector2Add(Vector2Lerp(p, q, f), Vector2Scale(n, sinf(f * PI) * sinf(t * 5 + i) * 6)); line(last, w, th * 1.1f, tint(Color{240, 214, 140, 255}), Color{150, 120, 60, 255}); last = w; } }); return true; }
    if (s == "dotted") { each([&](Vector2 p, Vector2 q, int) { float L = Vector2Distance(p, q); int n = std::max(2, (int)(L / (th * 1.6f))); for (int d = 0; d <= n; d++) { Vector2 m = Vector2Lerp(p, q, d / (float)n); DrawCircleV(m, th * 0.55f + 1.2f, A(INK)); DrawCircleV(m, th * 0.55f, A(tint(seat))); } }); return true; }
    if (s == "golden") { each([&](Vector2 p, Vector2 q, int i) { line(p, q, th * 1.1f, tint(Color{232, 190, 70, 255}), Color{110, 80, 20, 255}); float u = fmodf(t * 0.6f + i * 0.13f, 1.0f); DrawCircleV(Vector2Lerp(p, q, u), th * 0.3f, A(Color{255, 250, 210, 255})); }); return true; }
    if (s == "crayon") { each([&](Vector2 p, Vector2 q, int i) { for (int d = 0; d < 2; d++) { Vector2 o{(float)(Hash(i, d) % 5) - 2, (float)(Hash(d, i) % 5) - 2}; DrawLineEx(Vector2Add(p, o), Vector2Add(q, o), th * 0.8f, A(tint(ColorLerp(seat, Color{255, 240, 200, 255}, 0.15f)))); } }); return true; }
    if (s == "marker") { each([&](Vector2 p, Vector2 q, int) { DrawLineEx(p, q, th * 2.2f, A(ColorAlpha(seat, 0.3f))); line(p, q, th * 1.4f, tint(seat), ColorLerp(seat, BLACK, 0.5f)); }); return true; }
    if (s == "pencil") { each([&](Vector2 p, Vector2 q, int i) { for (int d = -1; d <= 1; d += 2) DrawLineEx({p.x + d, p.y + d * 0.5f}, {q.x - d, q.y + d}, std::max(1.2f, th * 0.35f), A(tint(Color{80, 80, 84, 220}))); }); return true; }
    if (s == "blueprint") { each([&](Vector2 p, Vector2 q, int) { line(p, q, th * 0.6f, tint(Color{230, 240, 255, 255}), Color{30, 70, 150, 255}); Vector2 d = Vector2Normalize(Vector2Subtract(q, p)), n{-d.y * 5, d.x * 5}; for (Vector2 e : {p, q}) DrawLineEx(Vector2Add(e, n), Vector2Subtract(e, n), 1, A(Color{230, 240, 255, 255})); }); return true; }
    if (s == "rust") { each([&](Vector2 p, Vector2 q, int i) { line(p, q, th, tint(Color{170, 90, 40, 255}), Color{70, 34, 16, 255}); for (int d = 0; d < 3; d++) DrawCircleV(Vector2Lerp(p, q, (Hash(i, d) % 100) / 100.0f), std::max(1.2f, th * 0.22f), A(Color{120, 60, 24, 255})); }); return true; }
    if (s == "barnacled") { each([&](Vector2 p, Vector2 q, int i) { line(p, q, th, tint(Color{120, 136, 120, 255}), INK); for (int d = 0; d < 2; d++) { Vector2 m = Vector2Lerp(p, q, 0.25f + 0.5f * d); DrawCircleV(m, th * 0.45f + 1, A(INK)); DrawCircleV(m, th * 0.45f, A(Color{220, 214, 196, 255})); DrawCircleV(m, th * 0.15f, A(INK)); } }); return true; }
    if (s == "candy") { each([&](Vector2 p, Vector2 q, int) { line(p, q, th * 1.1f, tint(WHITE), INK); for (int d = 0; d < 4; d++) DrawLineEx(Vector2Lerp(p, q, d / 4.0f), Vector2Lerp(p, q, d / 4.0f + 0.125f), th * 1.1f, A(tint(Color{210, 40, 40, 255}))); }); return true; }
    if (s == "pixel") { float g = std::max(3.0f, S.zoom * 0.07f); each([&](Vector2 p, Vector2 q, int) { float L = Vector2Distance(p, q); int n = std::max(2, (int)(L / g)); for (int d = 0; d <= n; d++) { Vector2 m = Vector2Lerp(p, q, d / (float)n); m.x = floorf(m.x / g) * g; m.y = floorf(m.y / g) * g; DrawRectangleV({m.x - 1, m.y - 1}, {g + 2, g + 2}, A(INK)); DrawRectangleV(m, {g, g}, A(tint(seat))); } }); return true; }
    if (s == "stitched") { each([&](Vector2 p, Vector2 q, int) { line(p, q, th, tint(ColorLerp(seat, Color{230, 210, 180, 255}, 0.4f)), INK); Vector2 d = Vector2Normalize(Vector2Subtract(q, p)), n{-d.y * th, d.x * th}; for (float u : {0.1f, 0.9f}) { Vector2 m = Vector2Lerp(p, q, u); DrawLineEx(Vector2Add(m, n), Vector2Subtract(m, n), 1.5f, A(INK)); } }); return true; }
    if (s == "wetpaint") { each([&](Vector2 p, Vector2 q, int i) { line(p, q, th * 1.1f, tint(seat), INK); if (fabsf(k.vel.x) > 2 && k.grounded) { Vector2 m = Vector2Lerp(p, q, 0.5f); float dl = fmodf(t * 3 + i * 0.3f, 1.0f) * 10; DrawLineEx(m, {m.x, m.y + dl}, 2, A(seat)); DrawCircleV({m.x, m.y + dl}, 2.2f, A(seat)); } }); return true; }
    if (s == "redtide") { each([&](Vector2 p, Vector2 q, int) { line(p, q, th, tint(Color{150, 20, 24, 255}), INK); }); if (k.hitT > 0) for (int d = 0; d < 6; d++) { Vector2 m = P(sf::J_NECK); DrawCircleV({m.x + sinf(d * 2.4f) * 14 * (1 - k.hitT), m.y + cosf(d * 1.9f) * 10 * (1 - k.hitT)}, 2.5f, A(Color{120, 10, 14, 255})); } return true; }
    if (s == "lightning") { each([&](Vector2 p, Vector2 q, int i) { DrawLineEx(p, q, th * 2.5f, A(ColorAlpha(Color{120, 200, 255, 255}, 0.2f))); Vector2 last = p; for (int u = 1; u <= 4; u++) { Vector2 w = Vector2Lerp(p, q, u / 4.0f); if (u < 4) { w.x += (float)((int)(Hash(i * 7 + u, (int)(t * 20)) % 9) - 4); w.y += (float)((int)(Hash(u, i + (int)(t * 20)) % 9) - 4); } DrawLineEx(last, w, std::max(2.0f, th * 0.5f), A(tint(Color{210, 240, 255, 255}))); last = w; } }); return true; }
    if (s == "molten") { each([&](Vector2 p, Vector2 q, int i) { line(p, q, th * 1.1f, tint(Color{60, 30, 24, 255}), INK); DrawLineEx(Vector2Lerp(p, q, 0.15f), Vector2Lerp(p, q, 0.85f), th * 0.45f, A(tint(ColorLerp(Color{255, 120, 30, 255}, Color{255, 220, 90, 255}, 0.5f + 0.5f * sinf(t * 4 + i))))); }); if (k.grounded) for (int d = 0; d < 3; d++) { float u = fmodf(t * 1.5f + d * 0.33f, 1.0f); Vector2 f = P(sf::J_FOOT_L); DrawCircleV({f.x + (d - 1) * 6.0f, f.y - u * 20}, 2 * (1 - u), A(Color{255, 160, 40, 255})); } return true; }
    if (s == "blobfish") { Vector2 n = P(sf::J_NECK), pl = P(sf::J_PELVIS), c = Vector2Lerp(n, pl, 0.5f); float r = Vector2Distance(n, pl) * 0.65f; each([&](Vector2 p, Vector2 q, int i) { if (i > 0 && i < 9) line(p, q, th * 0.7f, tint(Color{236, 168, 170, 255}), INK); }); DrawEllipse((int)c.x, (int)c.y, r + 2.5f, r * 1.2f + 2.5f, A(INK)); DrawEllipse((int)c.x, (int)c.y, r, r * 1.2f, A(tint(Color{236, 168, 170, 255}))); DrawEllipse((int)c.x, (int)(c.y + r * 0.3f), r * 0.5f, r * 0.3f, A(Color{220, 140, 150, 255})); return true; }
    if (s == "kidney") { each([&](Vector2 p, Vector2 q, int) { line(p, q, th, tint(seat), INK); }); Vector2 c = Vector2Lerp(P(sf::J_NECK), P(sf::J_PELVIS), 0.55f); float r = th * 1.3f; DrawEllipse((int)c.x, (int)c.y, r + 1.5f, r * 1.4f + 1.5f, A(INK)); DrawEllipse((int)c.x, (int)c.y, r, r * 1.4f, A(Color{240, 200, 70, 255})); DrawCircleV({c.x + r * 0.6f, c.y}, r * 0.45f, A(tint(seat))); for (int d = -1; d <= 1; d++) DrawLineEx({c.x - r - 2, c.y + d * r * 0.5f}, {c.x - r + 3, c.y + d * r * 0.5f + 2}, 1, A(INK)); return true; }
    return false;
}

// a hat at screen point h (the head's top), turned along `up` (screen, unit), r the head's radius on screen
void Hat(const std::string& id, Vector2 h, Vector2 up, float r, float alpha, int seed) {
    Vector2 rt{-up.y, up.x}; if (rt.x < 0) rt = Vector2Negate(rt);   // (the hat's right)
    auto at = [&](float x, float y) { return Vector2Add(h, Vector2Add(Vector2Scale(rt, x * r), Vector2Scale(up, y * r))); };
    auto C = [&](Color c) { return ColorAlpha(c, alpha * c.a / 255.0f); };
    auto quad = [&](float x0, float y0, float x1, float y1, Color c) { Vector2 a = at(x0, y0), b = at(x1, y0), cc = at(x1, y1), d = at(x0, y1); DrawTri(a, b, cc, C(c)); DrawTri(a, cc, d, C(c)); DrawLineEx(a, b, 2, C(INK)); DrawLineEx(b, cc, 2, C(INK)); DrawLineEx(cc, d, 2, C(INK)); DrawLineEx(d, a, 2, C(INK)); };
    auto tri = [&](Vector2 a, Vector2 b, Vector2 c, Color col) { DrawTri(a, b, c, C(col)); DrawLineEx(a, b, 2, C(INK)); DrawLineEx(b, c, 2, C(INK)); DrawLineEx(c, a, 2, C(INK)); };
    auto ball = [&](Vector2 p, float rr, Color c) { DrawCircleV(p, rr * r + 1.5f, C(INK)); DrawCircleV(p, rr * r, C(c)); };
    auto ell = [&](float x, float y, float rx, float ry, Color c) { Vector2 p = at(x, y); DrawEllipse((int)p.x, (int)p.y, rx * r + 1.5f, ry * r + 1.5f, C(INK)); DrawEllipse((int)p.x, (int)p.y, rx * r, ry * r, C(c)); };
    float t = S.t;
    if (id == "sailor") { quad(-0.95f, 0, 0.95f, 0.18f, Color{20, 24, 40, 255}); ell(0, 0.42f, 0.95f, 0.32f, WHITE); ball(at(0, 0.62f), 0.1f, Color{20, 24, 40, 255}); }
    else if (id == "diver") { ball(at(0, -0.6f), 1.35f, Color{190, 150, 70, 255}); ball(at(0.25f, -0.6f), 0.7f, Color{150, 190, 210, 255}); for (int i = 0; i < 6; i++) { float a = i * PI / 3; DrawCircleV(at(0.25f + cosf(a) * 0.82f, -0.6f + sinf(a) * 0.82f), 2, C(INK)); } }
    else if (id == "tophat") { quad(-0.9f, 0, 0.9f, 0.16f, Color{30, 28, 30, 255}); quad(-0.55f, 0.16f, 0.55f, 1.35f, Color{30, 28, 30, 255}); quad(-0.55f, 0.25f, 0.55f, 0.42f, Color{150, 40, 40, 255}); }
    else if (id == "crown") { quad(-0.6f, 0, 0.6f, 0.35f, Color{232, 190, 70, 255}); for (int i = 0; i < 5; i++) { float x = -0.6f + i * 0.3f; tri(at(x - 0.12f, 0.35f), at(x + 0.12f, 0.35f), at(x, 0.75f), Color{232, 190, 70, 255}); } ball(at(0, 0.18f), 0.1f, Color{200, 40, 50, 255}); }
    else if (id == "cone") { tri(at(-0.7f, 0), at(0.7f, 0), at(0, 1.6f), Color{240, 120, 30, 255}); quad(-0.4f, 0.45f, 0.4f, 0.65f, WHITE); quad(-0.85f, -0.05f, 0.85f, 0.1f, Color{240, 120, 30, 255}); }
    else if (id == "pan") { ell(0, 0.2f, 0.9f, 0.32f, Color{60, 60, 64, 255}); quad(0.8f, 0.12f, 1.9f, 0.28f, Color{110, 74, 40, 255}); }
    else if (id == "jellyfish") { ell(0, 0.3f, 0.85f, 0.5f, Color{220, 170, 230, 200}); for (int i = 0; i < 5; i++) { Vector2 a = at(-0.6f + i * 0.3f, 0.05f); DrawLineEx(a, Vector2Add(a, Vector2Scale(up, -r * (0.6f + 0.3f * sinf(t * 3 + i)))), 2, C(Color{200, 150, 220, 220})); } }
    else if (id == "tinykraken") { ell(0, 0.55f, 0.55f, 0.55f, Color{170, 50, 70, 255}); for (int i = 0; i < 4; i++) { float x = -0.45f + i * 0.3f; Vector2 a = at(x, 0.15f), b = at(x + sinf(t * 4 + i) * 0.3f, -0.25f); DrawLineEx(a, b, r * 0.18f + 2, C(INK)); DrawLineEx(a, b, r * 0.18f, C(Color{170, 50, 70, 255})); } ball(at(0.2f, 0.65f), 0.14f, WHITE); DrawCircleV(at(0.23f, 0.65f), r * 0.07f, C(INK)); }
    else if (id == "lighthouse") { quad(-0.35f, 0, 0.35f, 1.3f, WHITE); quad(-0.35f, 0.4f, 0.35f, 0.65f, Color{200, 40, 40, 255}); quad(-0.42f, 1.3f, 0.42f, 1.6f, Color{255, 230, 120, 255}); tri(at(-0.45f, 1.6f), at(0.45f, 1.6f), at(0, 1.95f), Color{200, 40, 40, 255}); float a = t * 2; Vector2 l = at(0, 1.45f); DrawTri(l, Vector2Add(l, {cosf(a) * r * 4, sinf(a) * r * 0.8f - r}), Vector2Add(l, {cosf(a) * r * 4, sinf(a) * r * 0.8f + r}), C(ColorAlpha(Color{255, 240, 160, 255}, 0.25f))); }
    else if (id == "fish") { ell(0, 0.35f, 1.05f, 0.42f, Color{110, 150, 170, 255}); tri(at(-0.95f, 0.35f), at(-1.5f, 0.75f), at(-1.5f, -0.05f), Color{110, 150, 170, 255}); ball(at(0.6f, 0.45f), 0.1f, WHITE); DrawCircleV(at(0.62f, 0.45f), r * 0.05f, C(INK)); }
    else if (id == "beanie") { ell(0, 0.25f, 0.85f, 0.55f, Color{60, 110, 160, 255}); quad(-0.88f, -0.05f, 0.88f, 0.2f, Color{50, 90, 130, 255}); ball(at(0, 0.85f), 0.18f, Color{230, 230, 230, 255}); }
    else if (id == "bandana") { quad(-0.95f, -0.1f, 0.95f, 0.3f, Color{200, 40, 40, 255}); for (int i = 0; i < 4; i++) DrawCircleV(at(-0.6f + i * 0.4f, 0.1f), r * 0.06f, C(WHITE)); tri(at(-0.95f, 0.1f), at(-1.5f, 0.4f + sinf(t * 5) * 0.1f), at(-1.4f, -0.2f), Color{200, 40, 40, 255}); }
    else if (id == "bucket") { quad(-1.1f, -0.05f, 1.1f, 0.12f, Color{200, 190, 150, 255}); quad(-0.65f, 0.12f, 0.65f, 0.75f, Color{200, 190, 150, 255}); }
    else if (id == "paperhat") { tri(at(-1.0f, 0), at(1.0f, 0), at(0, 0.9f), Color{236, 228, 200, 255}); DrawLineEx(at(-0.5f, 0.3f), at(0.5f, 0.35f), 1, C(Color{120, 140, 180, 255})); }
    else if (id == "headband") { quad(-0.92f, -0.15f, 0.92f, 0.1f, Color{230, 230, 230, 255}); for (int s = 0; s < 2; s++) DrawLineEx(at(-0.9f, 0), at(-1.6f, -0.2f - s * 0.3f + sinf(t * 6 + s) * 0.15f), 3, C(Color{230, 230, 230, 255})); }
    else if (id == "sombrero") { ell(0, 0.05f, 1.9f, 0.22f, Color{220, 180, 90, 255}); ell(0, 0.5f, 0.6f, 0.55f, Color{220, 180, 90, 255}); quad(-0.6f, 0.15f, 0.6f, 0.3f, Color{200, 50, 50, 255}); }
    else if (id == "beret") { Vector2 c = at(0.25f, 0.2f); DrawEllipse((int)c.x, (int)c.y, r * 1.0f + 1.5f, r * 0.35f + 1.5f, C(INK)); DrawEllipse((int)c.x, (int)c.y, r * 1.0f, r * 0.35f, C(Color{40, 40, 60, 255})); ball(at(0.25f, 0.55f), 0.08f, Color{40, 40, 60, 255}); }
    else if (id == "hardhat") { ell(0, 0.25f, 0.85f, 0.6f, Color{240, 200, 30, 255}); quad(-1.05f, -0.05f, 1.05f, 0.12f, Color{240, 200, 30, 255}); }
    else if (id == "partyhat") { tri(at(-0.55f, 0), at(0.55f, 0), at(0, 1.5f), Color{80, 160, 220, 255}); DrawLineEx(at(-0.3f, 0.5f), at(0.35f, 0.4f), 3, C(Color{240, 220, 60, 255})); DrawLineEx(at(-0.15f, 1.0f), at(0.2f, 0.9f), 3, C(Color{240, 80, 140, 255})); ball(at(0, 1.6f), 0.16f, Color{240, 80, 140, 255}); }
    else if (id == "flower") { for (int i = 0; i < 5; i++) { float a = i * PI * 0.4f; ball(at(0.75f + cosf(a) * 0.22f, 0.1f + sinf(a) * 0.22f), 0.16f, Color{240, 130, 170, 255}); } ball(at(0.75f, 0.1f), 0.12f, Color{250, 220, 80, 255}); }
    else if (id == "antenna") { for (int s : {-1, 1}) { Vector2 a = at(s * 0.35f, 0), b = at(s * 0.55f + sinf(t * 5 + s) * 0.15f, 1.1f); DrawLineEx(a, b, 2, C(INK)); ball(b, 0.16f, Color{120, 220, 120, 255}); } }
    else if (id == "goggles") { quad(-0.95f, -0.05f, 0.95f, 0.12f, Color{110, 74, 40, 255}); for (int s : {-1, 1}) { ball(at(s * 0.42f, 0.05f), 0.3f, Color{190, 150, 70, 255}); ball(at(s * 0.42f, 0.05f), 0.2f, Color{150, 200, 220, 255}); } }
