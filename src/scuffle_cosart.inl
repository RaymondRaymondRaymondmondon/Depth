// the hat on a stick (on the head, turned with it)
void HatOn(const sf::Stick& k, float alpha) {
    std::string id = HatId(k.hat); if (id.empty() || !k.present) return;
    Vector2 h = W2S(k.pt[sf::J_HEAD].p), n = W2S(k.pt[sf::J_NECK].p); Vector2 up = Vector2Normalize(Vector2Subtract(h, n)); if (Vector2Length(up) < 0.5f) up = {0, -1};
    float r = k.pt[sf::J_HEAD].r * S.zoom;
    Hat(id, Vector2Add(h, Vector2Scale(up, r * 0.75f)), up, r, alpha, k.id);
}
// hats loose in the world (tumbling while they fly)
void LooseHats() {
    for (const auto& th : S.M.w.things) {
        if (!th.alive || th.kind != sf::TH_HAT) continue;
        Vector2 p = W2S(th.p); float r = 0.13f * S.zoom; Vector2 up{sinf(th.a), -cosf(th.a)};
        Hat(HatId(th.weapon), Vector2Add(p, Vector2Scale(up, -r * 0.3f)), up, r, 1, th.weapon);
    }
}
